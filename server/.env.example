# ============================================================
# Ever Nova Life — backend configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env to git.
#
# Payments are BTCPay (Bitcoin / Lightning) and, optionally, Zelle.
# The BTCPay settings are further down — without them the store has
# no working payment method at all.
# ============================================================

# Currency all prices and invoices are denominated in.
CURRENCY=USD

# Port this API server listens on.
PORT=4242

# Comma-separated list of origins allowed to call this API.
# Use "*" only for local testing. In production list your real site origin,
# e.g. https://evernovalife.com
ALLOWED_ORIGINS=*

# ------------------------------------------------------------
# Accounts — sign in / sign up (email + password)
# ------------------------------------------------------------
# Secret used to sign login tokens (JWTs). Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left blank the server uses a random secret that changes on every
# restart (fine for local dev, but all logins break when it restarts).
JWT_SECRET=

# How long a login stays valid (e.g. 7d, 30d, 12h). Optional; default 30d.
JWT_TTL=30d

# ------------------------------------------------------------
# Password-reset emails — Gmail SMTP
# ------------------------------------------------------------
# Your Gmail address, and a Google "App Password" (NOT your normal password).
# Create one: Google Account -> Security -> 2-Step Verification (must be ON)
# -> App passwords -> generate one for "Mail". Paste the 16-char code as SMTP_PASS.
SMTP_USER=
SMTP_PASS=
# Optional overrides (defaults are Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=Ever Nova Life <you@gmail.com>

# ------------------------------------------------------------
# Admin — view + manage (delete) users
# ------------------------------------------------------------
# A long random secret. Optional fallback: it still works on admin.html,
# but the main way to administer is to sign in with an admin account below.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=
# Where "new signup" notification emails are sent (usually your own inbox).
ADMIN_EMAIL=
# The account(s) that get admin powers (view + delete users). Sign in normally
# with one of these emails and admin tools appear. Comma-separated for several.
# If left blank, ADMIN_EMAIL (above) is used as the single admin account.
# ADMIN_EMAILS=owner@evernovalife.com,partner@evernovalife.com

# ------------------------------------------------------------
# Loyalty points + referral rewards
# ------------------------------------------------------------
# All optional — the defaults below are used if left blank.
# Points earned per $1 of product spend (default 1).
POINTS_PER_DOLLAR=1
# Cash value of ONE point, in cents (default 1 → 100 points = $1).
POINTS_VALUE_CENTS=1
# Points granted to BOTH the referrer and the new customer when a referred
# account places its first paid order (default 500 → worth $5 each at the
# defaults above). Set to 0 to disable referral rewards.
REFERRAL_REWARD_POINTS=500

# ------------------------------------------------------------
# Crypto payments — BTCPay Server (Bitcoin / Lightning)
# ------------------------------------------------------------
# Base URL of YOUR BTCPay instance (no trailing slash), e.g.
# https://btcpay.evernovalife.com
BTCPAY_URL=

# Greenfield API key: BTCPay -> Account -> Manage Account -> API Keys.
# Give it (at minimum) the "btcpay.store.cancreateinvoice" permission
# scoped to your store.
BTCPAY_API_KEY=

# Your store id: BTCPay -> Store Settings (also shown in the store URL).
BTCPAY_STORE_ID=

# Webhook secret shown when you create the webhook in BTCPay
# (Store -> Settings -> Webhooks). Point the webhook at:
#   https://<this-api>/api/crypto/webhook
# If left blank, incoming webhook calls are rejected (can't verify them).
BTCPAY_WEBHOOK_SECRET=

# ---- how long a buyer gets, and how exact they have to be ----
# Set on every invoice this server raises, so they don't depend on anyone
# remembering to change a store setting in the BTCPay UI. Leave them blank
# unless you have a reason — the defaults below are what the code uses.
#
# How long the invoice stays payable. BTCPay's own default is 15 minutes,
# which is not enough to open a wallet or move coin off an exchange — and an
# invoice that dies mid-payment banks whatever arrived as a partial payment.
# Default 60. (min 10, max 1440)
BTCPAY_EXPIRY_MINUTES=
#
# How long after expiry we keep watching the address, so a late payment is
# still SEEN and can be settled instead of landing in the wallet attached to
# nothing. Default 1440 (24h). (max 20160)
BTCPAY_MONITORING_MINUTES=
#
# Percent under the asking price that still counts as paid in full. This is
# for wallet-fee dust — a sender's wallet deducting its network fee from the
# amount sent — NOT for real shortfalls. Default 1. (max 5)
BTCPAY_PAYMENT_TOLERANCE=
#
# Confirmations before BTCPay calls an invoice settled:
#   HighSpeed (0-conf) · MediumSpeed (1) · LowMediumSpeed (2) · LowSpeed (6)
# Default MediumSpeed.
BTCPAY_SPEED_POLICY=

# Absolute URL of your storefront, used to send buyers back after paying.
# Optional — if blank, the server uses the request Origin. Set it when the
# API and site are on different hosts, e.g. https://evernovalife.com
SITE_URL=

# Absolute URL of THIS API, e.g. https://evernova-api.onrender.com
# Optional. Only used by the admin webhook check, to tell you whether the
# webhook registered in BTCPay actually points at this server. If blank, the
# host the admin page called through is assumed.
API_URL=

# ------------------------------------------------------------
# Zelle — manual bank transfer (US only)
# ------------------------------------------------------------
# Zelle has no merchant API: the buyer sends the money themselves from their
# banking app, and YOU confirm it landed on admin.html ("Payments to Confirm").
# Leave these blank and the Zelle option simply doesn't appear at checkout.
#
# IMPORTANT: use a Zelle-for-BUSINESS enrollment through your bank. Consumer
# Zelle terms don't cover paying for goods, and there is no chargeback or
# seller protection either way — you keep whatever lands, but a buyer who
# doesn't pay just... doesn't pay. Nothing ships until you confirm.

# The email address or US mobile number enrolled with Zelle that buyers send to.
ZELLE_RECIPIENT=
# The name buyers will see in their banking app when they enter the above.
# Showing it up front stops "is this the right business?" support emails.
ZELLE_NAME=
# Optional — your bank's name, shown to the buyer for reassurance.
ZELLE_BANK=
# Optional — how long an unpaid order is held before it looks stale in admin,
# in hours (default 24, max 168). Nothing is cancelled automatically.
# ZELLE_WINDOW_HOURS=24
# Optional — refuse Zelle on orders above this dollar amount, so a buyer
# doesn't hit their bank's daily send limit halfway through. 0/blank = no cap.
# ZELLE_MAX_TOTAL=1000

# ------------------------------------------------------------
# Auto-ship — repeating orders (recurring charges)
# ------------------------------------------------------------
# Shared secret for the scheduled trigger that charges due plans.
# The external cron service sends it as the "x-cron-key" header when it
# calls POST /api/subscriptions/run-due. Without it, only a signed-in
# admin account can trigger a run.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_KEY=

# Optional tuning — the defaults are sensible; change only if you mean to.
# Range of intervals a customer may choose, in days (default 7 to 180).
# SUBSCRIPTION_MIN_DAYS=7
# SUBSCRIPTION_MAX_DAYS=180
# Days to wait before retrying a shipment we couldn't invoice (default 3).
# SUBSCRIPTION_RETRY_DAYS=3
# Failed attempts allowed before the plan auto-pauses (default 3).
# SUBSCRIPTION_MAX_FAILS=3
# Days ahead of each shipment to email the "shipping soon" notice (default 3).
# Set to 0 to switch the advance notice off — not recommended: it's the
# customer's chance to skip or cancel before the next invoice goes out.
# SUBSCRIPTION_REMINDER_DAYS=3
# How often the in-process backstop timer checks for due plans, in minutes
# (default 60). The real trigger is the external cron ping — this only runs
# while the process happens to be awake. Set SUBSCRIPTION_INPROCESS_CRON=0
# to turn it off entirely.
# SUBSCRIPTION_TICK_MINUTES=60
# SUBSCRIPTION_INPROCESS_CRON=1
